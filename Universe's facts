<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Universe's Facts</title>

<style>
:root{
  --dark:#1A1A1A;
  --light:#F4F1DE;
  --accent:#F2CC8F;
}

*{margin:0;padding:0;box-sizing:border-box;font-family:Arial;}

body{background:var(--dark);color:var(--light);}

.hero{
  text-align:center;
  padding:60px 20px;
}

.hero h1{
  font-size:38px;
}

.form-box{
  max-width:520px;
  margin:auto;
  background:#111;
  padding:25px;
  border-radius:12px;
}

input,select,textarea{
  width:100%;
  padding:12px;
  margin:8px 0;
  border:none;
  border-radius:6px;
}

button{
  width:100%;
  padding:14px;
  background:var(--accent);
  border:none;
  font-weight:bold;
  cursor:pointer;
  border-radius:6px;
}

/* SUCCESS */
#success{
  display:none;
  position:fixed;
  top:0;left:0;
  width:100%;height:100%;
  background:rgba(0,0,0,0.92);
  justify-content:center;
  align-items:center;
  flex-direction:column;
}

.check{
  font-size:90px;
  color:lime;
  animation:pop 0.4s ease;
}

@keyframes pop{
  from{transform:scale(0);}
  to{transform:scale(1);}
}

.address{
  position:fixed;
  bottom:6px;
  right:10px;
  font-size:10px;
  opacity:0.5;
}
.address:hover{opacity:1;}

</style>
</head>

<body>

<div class="hero">
<h1>Universe's Facts</h1>
<p>Premium Social Media Promotion Agency</p>
</div>

<div class="form-box">

<input type="text" id="name" placeholder="Full Name">
<input type="email" id="email" placeholder="Email ID">
<input type="text" id="phone" placeholder="Phone Number">
<input type="text" id="page" placeholder="Page Name">
<input type="text" id="links" placeholder="Social Links">

<select id="type">
<option>Basic</option>
<option>Standard</option>
<option>Premium</option>
</select>

<input type="text" id="budget" placeholder="Budget">
<input type="text" id="duration" placeholder="Duration">
<textarea id="msg" placeholder="Message"></textarea>

<button onclick="submitData()">Submit Request</button>

</div>

<!-- SUCCESS -->
<div id="success">
<div class="check">✔</div>
<h2>Thank You!</h2>
<p>We will contact you soon.</p>
</div>

<div class="address">
India, Dhubri, Bilasipara, Lakhiganj
</div>

<script>

/* TELEGRAM CREDENTIALS (ADDED) */
let botToken = "8641845785:AAEAtaSP0pkx4QAuGvLrXmC-iiOyigyefaI";
let chatId = "8719144917";

function submitData(){

let name=document.getElementById("name").value;
let email=document.getElementById("email").value;
let phone=document.getElementById("phone").value;
let page=document.getElementById("page").value;
let links=document.getElementById("links").value;
let type=document.getElementById("type").value;
let budget=document.getElementById("budget").value;
let duration=document.getElementById("duration").value;
let msg=document.getElementById("msg").value;

let text = `🔥 New Promotion Request
Name: ${name}
Email: ${email}
Phone: ${phone}
Page: ${page}
Type: ${type}
Budget: ${budget}
Duration: ${duration}
Message: ${msg}`;

/* SEND TO TELEGRAM */
fetch(`https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${chatId}&text=${encodeURIComponent(text)}`);

/* SUCCESS ANIMATION */
document.getElementById("success").style.display="flex";

setTimeout(()=>{
document.getElementById("success").style.display="none";
},3500);

}

</script>

</body>
</html>
